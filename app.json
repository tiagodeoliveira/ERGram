{
  "package_id": "ergram.tiago.tools",
  "edition": "202601",
  "name": "ERGram",
  "version": "0.1.1",
  "min_app_version": "2.0.0",
  "min_sdk_version": "0.0.10",
  "entrypoint": "index.html",
  "permissions": [
    {
      "name": "g2-microphone",
      "desc": "Capture audio from the glasses mic for push-to-talk voice messages (transcription)."
