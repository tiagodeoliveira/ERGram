{
  "name": "ergram",
  "description": "Talk on a Telegram group from Even Realities G2 smart glasses: push-to-talk voice, transcribed by Soniox and sent via a Telegram userbot.",
  "license": "MIT",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "pnpm build && evenhub pack app.json dist -o ergram.ehpk",
    "sim": "concurrently -n vite,sim -c blue,green \"vite\" \"wait-on http://localhost:5173 && evenhub-simulator http://localhost:5173 --automation-port 9898 ${ERGRAM_SIM_AID:+--aid $ERGRAM_SIM_AID}\"",
    "simulate": "evenhub-simulator http://localhost:5173",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md,yml,yaml,html}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md,yml,yaml,html}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10",
    "@evenrealities/pretext": "^0.1.4",
    "buffer": "^6.0.3",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.7.2",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "concurrently": "^8.2.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^2.1.8",
    "wait-on": "^7.2.0"
  },
  "pnpm": {
    "overrides": {
      "buffer": "6.0.3"
    }
  }
}
